<mujoco model="type_sphere">
  <!-- 动态干扰用的球体：按“最大半径”建(0.06)，运行期只缩小(episode 级) =>
       geom_rbound 保守。
       该 suite 的语义是「只影响点云」：球是 mocap/kinematic(无重力、无 joint)，
       且 contype=conaffinity=0 => 与手/桌面**零接触**(可穿过)，只进入
       depth 渲染 -> 点云/图像。(见 dr3d/bench/dynamic.py) -->
  <worldbody>
    <body name="object">
      <geom name="sphere_geom" type="sphere" size="0.06 0 0" pos="0 0 0"
            rgba="0.15 0.55 1 1" condim="4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
