<mujoco model="inspire left hand">
    <!-- inspire 左手(MuJoCo port) —— dr3d 第 4 个动态干扰 suite(dynhand) 的源资产。

     来源: dr3d/distractors/inspire/inspire_left_hand.xml(vendor 原件, 见 git 历史
           commit ea9a3e4; 同目录原有的 13 个 rh_* 右手网格未被本模型引用, 已按
           "只保留被引用资产"原则删除, 快照同样在 git 历史里)。
     相对原件的清理(详见 ../../bench/dynamic_hand.py 与 Eval.md):
       * 只保留 13 个 lh_*_vis mesh(删 13 个重复 _col mesh 与全部 rh_* 文件)
       * 删 17 个 <site> 与 <sensor>(grip_site/grip_site_cylinder 会在 depth 里
         投出 1m 长假柱, 污染点云) / 删 13 个 <position> actuator(保持场景 nu=26)
       * 删根 body 的 <inertial mass="0">、<contact> excludes(零接触下无意义)
       * 去 mj_envs 内置 MuJoCo(2.0/2.1) 不支持的属性(autolimits / <visual><global> 等)
       * 12 个手指 hinge: limited="true"(原有) + 内联 damping="100"
       * 全 geom contype=0 conaffinity=0 —— dynhand 为零接触(只进 depth 渲染)

     结构: left_hand(根, 自带 quat) -> l_palm -> l_thumb / l_index / l_middle /
           l_ring / l_pinky
     关节: 12 个 hinge, 全部只为屈曲(轴 = 手指局部 ±z):
           thumb proximal_1[0,1.30] / proximal_2[0,0.71] / middle[0,0.97] / distal[0,1.20]
           index  proximal[0,1.62] + distal[0,1.82]
           middle proximal[0,1.62] + distal[0,1.82]
           ring   proximal[0,1.62] + distal[0,1.80]
           pinky  proximal[0,1.62] + distal[0,1.90]
           (0 = 伸展, 上界 = 屈曲; 四指无外展自由度, 拇指 proximal_1 有横向分量)
     ⚠ 5 处上限按用户参考姿态放宽(dr3d/MJDATA/{open,fist,V,rock&roll}MJDATA.TXT
       的 QPOS): thumb_proximal_2 0.68->0.71, thumb_middle 0.68->0.97,
       thumb_distal 0.77->1.20, ring_distal 1.75->1.80, pinky_distal 1.87->1.90;
       目的是 1:1 复现参考姿态(零接触, 上限只影响可见姿态, 无物理影响)。
     用法: compose.py 以 mocap 方式注入(见 bench/dynamic_hand.py), 本文件必须能 standalone 加载
-->
  <compiler angle="radian" meshdir="./"/>

    <asset>
        <mesh name="l_palm_vis" file="meshes/lh_base_link.STL"/>

        <mesh name="l_thumb_proximal_1_vis" file="meshes/lh_Link11.STL"/>

        <mesh name="l_thumb_proximal_2_vis" file="meshes/lh_Link12.STL"/>

        <mesh name="l_thumb_middle_vis" file="meshes/lh_Link13.STL"/>

        <mesh name="l_thumb_distal_vis" file="meshes/lh_Link14.STL"/>

        <mesh name="l_index_proximal_vis" file="meshes/lh_Link15.STL"/>

        <mesh name="l_index_distal_vis" file="meshes/lh_Link16.STL"/>

        <mesh name="l_middle_proximal_vis" file="meshes/lh_Link17.STL"/>

        <mesh name="l_middle_distal_vis" file="meshes/lh_Link18.STL"/>

        <mesh name="l_ring_proximal_vis" file="meshes/lh_Link19.STL"/>

        <mesh name="l_ring_distal_vis" file="meshes/lh_Link20.STL"/>

        <mesh name="l_pinky_proximal_vis" file="meshes/lh_Link21.STL"/>

        <mesh name="l_pinky_distal_vis" file="meshes/lh_Link22.STL"/>

        <material name="l_base_material" rgba="0 0 0 1"/>
        <material name="l_thumb_material" rgba="0 0 0 1"/>
        <material name="l_index_material" rgba="0 0 0 1"/>
        <material name="l_middle_material" rgba="0 0 0 1"/>
        <material name="l_ring_material" rgba="0 0 0 1"/>
        <material name="l_pinky_material" rgba="0 0 0 1"/>

        <material name="l_thumb_distal_material" rgba="0 0 0 1"/>

    </asset>

    <worldbody>
        <body name="left_hand" pos="0 0 0" quat="0.7071068 0.7071068 0 0">
            <body name="l_palm" pos="0 0 0">

                <geom name="l_palm_vis" type="mesh" mesh="l_palm_vis" material="l_base_material" group="1" contype="0" conaffinity="0"/>
                <body name="l_thumb" pos="0. 0. 0.">
                    <body name="l_thumb_proximal_1" pos="-0.01496 -0.0375 0.02045" quat="0.5 0.5 -0.5 0.5">
                        <joint name="joint_l_thumb_proximal_1" type="hinge" pos="0 0 0" axis="0 0 1" range="0 1.30" limited="true" damping="100" />
                        <geom name="l_thumb_proximal_vis" type="mesh" mesh="l_thumb_proximal_1_vis" material="l_thumb_material" group="1" contype="0" conaffinity="0"> </geom>
                        <body name="l_thumb_proximal_2" pos="0.0099867 0.0098242 -0.0089" quat="0.705 -0.705 -0.060 0.060">
                            <joint name="joint_l_thumb_proximal_2" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 0.71" limited="true" damping="100" />
                            <geom name="l_thumb_proximal_2_vis" type="mesh" mesh="l_thumb_proximal_2_vis" material="l_thumb_material" group="1" contype="0" conaffinity="0"> </geom>
                            <body name="l_thumb_middle" pos="0.04407 -0.034553 -0.0008" quat="1 0 0 0">
                                <joint name="joint_l_thumb_middle" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 0.97" limited="true" damping="100" />
                                <geom name="l_thumb_middle_vis" type="mesh" mesh="l_thumb_middle_vis" material="l_thumb_material" group="1" contype="0" conaffinity="0"/>
                                <body name="l_thumb_distal" pos="0.020248 -0.010156 -0.0012" quat="1 0 0 0">
                                    <joint name="joint_l_thumb_distal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.20" limited="true" damping="100" />
                                    <geom name="l_thumb_distal_vis" type="mesh" mesh="l_thumb_distal_vis" material="l_thumb_distal_material" group="1" contype="0" conaffinity="0"> </geom>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
                <body name="l_index" pos="0 0 0">
                    <body name="l_index_proximal" pos="0.0022853 -0.10493 0.032268" quat="0.99985 -0.01745 0.0 0.0">
                        <joint name="joint_l_index_proximal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.62" limited="true" damping="100" />
                        <geom name="l_index_proximal_vis" type="mesh" mesh="l_index_proximal_vis" material="l_index_material" group="1" contype="0" conaffinity="0"/>
                        <body name="l_index_distal" pos="-0.0024229 -0.032041 -0.001" quat="1 0 0 0">
                            <joint name="joint_l_index_distal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.82" limited="true" damping="100" />
                            <geom name="l_index_distal_vis" type="mesh" mesh="l_index_distal_vis" material="l_index_material" group="1" contype="0" conaffinity="0"/>
                        </body>
                    </body>
                </body>
                <body name="l_middle" pos="0 0 0">
                    <body name="l_middle_proximal" pos="0.0022853 -0.1055 0.01295" quat="1 0 0 0">
                        <joint name="joint_l_middle_proximal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.62" limited="true" damping="100" />
                        <geom name="l_middle_proximal_vis" type="mesh" mesh="l_middle_proximal_vis" material="l_middle_material" group="1" contype="0" conaffinity="0"/>
                        <body name="l_middle_distal" pos="-0.0024229 -0.032041 -0.001" quat="1 0 0 0">
                            <joint name="joint_l_middle_distal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.82" limited="true" damping="100" />
                            <geom name="l_middle_distal_vis" type="mesh" mesh="l_middle_distal_vis" material="l_middle_material" group="1" contype="0" conaffinity="0"/>
                        </body>
                    </body>
                </body>
                <body name="l_ring" pos="0 0 0">
                    <body name="l_ring_proximal" pos="0.0022853 -0.10531 -0.0062872" quat="0.99966 0.02618 0.0 0.0">
                        <joint name="joint_l_ring_proximal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.62" limited="true" damping="100" />
                        <geom name="l_ring_proximal_vis" type="mesh" mesh="l_ring_proximal_vis" material="l_ring_material" group="1" contype="0" conaffinity="0"/>
                        <body name="l_ring_distal" pos="-0.0024229 -0.032041 -0.001" quat="1 0 0 0">
                            <joint name="joint_l_ring_distal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.80" limited="true" damping="100" />
                            <geom name="l_ring_distal_vis" type="mesh" mesh="l_ring_distal_vis" material="l_ring_material" group="1" contype="0" conaffinity="0"/>
                        </body>
                    </body>
                </body>
                <body name="l_pinky" pos="0 0 0">
                    <body name="l_pinky_proximal" pos="0.0022853 -0.10411 -0.025488" quat="0.99863 0.05234 0.0 0.0">
                        <joint name="joint_l_pinky_proximal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.62" limited="true" damping="100" />
                        <geom name="l_pinky_proximal_vis" type="mesh" mesh="l_pinky_proximal_vis" material="l_pinky_material" group="1" contype="0" conaffinity="0"/>
                        <body name="l_pinky_distal" pos="-0.0024229 -0.032041 -0.001" quat="1 0 0 0">
                            <joint name="joint_l_pinky_distal" type="hinge" pos="0 0 0" axis="0 0 -1" range="0 1.90" limited="true" damping="100" />
                            <geom name="l_pinky_distal_vis" type="mesh" mesh="l_pinky_distal_vis" material="l_pinky_material" group="1" contype="0" conaffinity="0"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>
    </mujoco>
